# Copy to .env and fill in. Never commit .env.

# PostgreSQL (local docker compose default shown). Production uses the Supabase *session
# pooler* URL (IPv4; the direct db.<ref>.supabase.co host is IPv6 only), e.g.
# postgresql+psycopg://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://vayu:vayu@localhost:5433/vayukavach

# CPCB real-time AQI via data.gov.in (free key from your data.gov.in dashboard)
DATA_GOV_IN_API_KEY=

# OpenAQ v3 (free key from explore.openaq.org, sent as X-API-Key)
OPENAQ_API_KEY=
# Optional: history to backfill (default 90) and skip low-cost sensors (default 0)
# OPENAQ_BACKFILL_DAYS=30
# OPENAQ_REFERENCE_ONLY=1

# Gemini API free tier (Ask VayuKavach chatbot). Without a key (and without OLLAMA_MODEL) the
# chatbot uses its rule-based engine: same data and guardrails, template answers.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Offline fallback: a tool-capable model in Ollama (e.g. gemma3, qwen2.5)
# OLLAMA_MODEL=
# OLLAMA_URL=http://localhost:11434

# Optional: OpenRouteService key for routes (free at openrouteservice.org); else public OSRM
ORS_API_KEY=

# Telegram Bot API (alerts)
TELEGRAM_BOT_TOKEN=

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5180
